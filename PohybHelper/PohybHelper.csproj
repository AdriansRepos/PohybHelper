<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>PohybHelper</Title>
    <Version>1.1.0</Version>
    <Authors>AdriansRepos</Authors>
    <Description>Sdílené základní typy pro evidenci pohybů (skladových, pokladních, finančních) napříč aplikacemi.</Description>
    <PackageProjectUrl>https://github.com/AdriansRepos/PohybHelper</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/AdriansRepos/PohybHelper</RepositoryUrl>
    <AssemblyVersion>1.1.0</AssemblyVersion>
    <FileVersion>1.1.0</FileVersion>

  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
